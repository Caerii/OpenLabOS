# Host port for the operator console and API.
OPENLABOS_PORT=3847

# The default operator profile hides engineering-only surfaces.
LABOS_EXPERIENCE_PROFILE=operator

# Inference defaults to an Ollama server running on the Docker host.
OPENLABOS_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision

# The lightweight Compose stack uses deterministic mock segmentation.
# grounded_sam2 requires the heavyweight perception dependencies and model assets.
LABOS_SEGMENTATION_BACKEND=mock
LABOS_SEGMENTATION_TOKEN=

# Because Compose binds the app to localhost, this is the safe default.
CORS_ORIGIN=http://localhost:3847
