{
  "name": "@openlabos/device-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeviceAdapter for the Android device-owner reference app (Mentra Live + K900 family). Speaks the on-device HTTP API on port 8080.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "capture": "tsx scripts/capture-replay.ts"
  },
  "dependencies": {
    "@openlabos/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
