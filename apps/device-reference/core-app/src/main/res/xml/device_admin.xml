<?xml version="1.0" encoding="utf-8"?>
<device-admin>
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <!-- disable-camera removed: we never want to disable the camera,
             and declaring this policy caused K900 CameraService to restrict
             camera access for other UIDs (like the camera module) -->
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
