{
  "name": "openlabos",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open, interoperable operating system for augmented laboratory work.",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "build:api": "pnpm --filter @openlabos/api build",
    "build:web": "pnpm --filter @openlabos/web build",
    "check": "pnpm typecheck && pnpm test:offline && pnpm sidecar:smoke",
    "dev": "turbo run dev --parallel",
    "device:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-device-debug.ps1",
    "device:prebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-device-prebuilts.ps1",
    "device:prebuild:no-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-device-prebuilts.ps1 -SkipBuild",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/openlabos-doctor.ps1",
    "doctor:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/openlabos-doctor.ps1 -Full",
    "desktop:prepare-runtime": "pnpm --filter @openlabos/web build && pnpm --filter @openlabos/desktop build:api-sidecar",
    "desktop:verify-runtime": "pnpm --filter @openlabos/desktop verify:runtime",
    "desktop:hash-artifacts": "pnpm --filter @openlabos/desktop hash:artifacts",
    "desktop:smoke-built-app": "pnpm --filter @openlabos/desktop smoke:built-app",
    "desktop:bump-version": "pnpm --filter @openlabos/desktop bump-version",
    "desktop:configure-signing-secrets": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/scripts/configure-github-signing-secrets.ps1",
    "desktop:dev": "pnpm --filter @openlabos/desktop dev",
    "desktop:build": "pnpm --filter @openlabos/desktop build",
    "desktop:typecheck": "pnpm --filter @openlabos/desktop typecheck",
    "deck:build": "pnpm --filter @openlabos/devtools slides",
    "deck:overview": "pnpm --filter @openlabos/devtools slides:overview",
    "lint": "turbo run lint",
    "local-agent": "pnpm --filter @openlabos/api dev",
    "local-agent:register-protocol": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-openlabos-protocol.ps1",
    "local-agent:tunnel": "pnpm --filter @openlabos/api local-agent:tunnel",
    "local-agent:tunnel:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-cloudflared.ps1",
    "local-agent:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-agent-stack.ps1",
    "power:matrix": "pnpm --filter @openlabos/api power:matrix",
    "power:profile": "pnpm --filter @openlabos/api power:profile",
    "replay:fixture": "pnpm --filter @openlabos/api replay:fixture",
    "session:export": "pnpm --filter @openlabos/api session:export",
    "sidecar:smoke": "python scripts/check-sidecar-smoke.py",
    "test": "turbo run test",
    "test:all": "pnpm --filter @openlabos/api test:all",
    "test:device": "pnpm --filter @openlabos/api test:device",
    "test:live": "pnpm --filter @openlabos/api test:live",
    "test:offline": "pnpm --filter @openlabos/api test:offline",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "pnpm --filter @openlabos/api typecheck",
    "typecheck:web": "pnpm --filter @openlabos/web typecheck",
    "voice:protocol": "pnpm --filter @openlabos/api voice:protocol",
    "voice:samples": "pnpm --filter @openlabos/api voice:samples",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
