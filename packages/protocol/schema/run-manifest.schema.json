{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "manifest_version": {
      "type": "number",
      "const": 1
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "device_adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "operator_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "completed",
            "abandoned",
            "errored"
          ]
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "session_id",
        "protocol_id",
        "protocol_version",
        "device_adapter_id",
        "started_at",
        "status",
        "tags"
      ],
      "additionalProperties": false
    },
    "protocol_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "step_started"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "step_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "at",
              "step_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "frame_captured"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_uri": {
                "type": "string",
                "minLength": 1
              },
              "sensor_snapshot_uri": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "at",
              "step_id",
              "frame_uri"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "judgment_emitted"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "judgment_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "kind",
              "at",
              "step_id",
              "judgment_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "step_completed"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "succeeded": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "at",
              "step_id",
              "succeeded"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "operator_note"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "at",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "measurement_recorded"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "s",
                  "min",
                  "h",
                  "C",
                  "K",
                  "uL",
                  "mL",
                  "L",
                  "ug",
                  "mg",
                  "g",
                  "kg",
                  "nm",
                  "um",
                  "mm",
                  "cm",
                  "m",
                  "M",
                  "mM",
                  "uM",
                  "mg_per_mL",
                  "rpm",
                  "g_force",
                  "Pa",
                  "kPa",
                  "bar",
                  "psi",
                  "percent",
                  "pH",
                  "count"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "instrument",
                  "display_readout",
                  "operator_attested",
                  "visual_estimate"
                ]
              },
              "instrument_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "at",
              "step_id",
              "quantity",
              "value",
              "unit",
              "method"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "session_finalized"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "active",
                  "completed",
                  "abandoned",
                  "errored"
                ]
              }
            },
            "required": [
              "kind",
              "at",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "judgment_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "frame_uri": {
            "type": "string",
            "minLength": 1
          },
          "emitted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "succeeded",
              "in_progress",
              "failed",
              "indeterminate"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "observed_objects": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "object_id",
                "confidence"
              ],
              "additionalProperties": false
            }
          },
          "criteria": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "criterion_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "satisfied": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "instrument",
                    "display_readout",
                    "operator_attested",
                    "visual_estimate"
                  ]
                },
                "measured_value": {
                  "type": "number"
                },
                "measured_unit": {
                  "type": "string",
                  "enum": [
                    "s",
                    "min",
                    "h",
                    "C",
                    "K",
                    "uL",
                    "mL",
                    "L",
                    "ug",
                    "mg",
                    "g",
                    "kg",
                    "nm",
                    "um",
                    "mm",
                    "cm",
                    "m",
                    "M",
                    "mM",
                    "uM",
                    "mg_per_mL",
                    "rpm",
                    "g_force",
                    "Pa",
                    "kPa",
                    "bar",
                    "psi",
                    "percent",
                    "pH",
                    "count"
                  ]
                }
              },
              "required": [
                "criterion_index",
                "satisfied",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "failure": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "judgment_id",
          "session_id",
          "step_id",
          "frame_uri",
          "emitted_at",
          "source",
          "verdict",
          "rationale",
          "observed_objects",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "manifest_version",
    "session",
    "protocol_hash",
    "events",
    "judgments",
    "artifacts"
  ],
  "additionalProperties": false
}
