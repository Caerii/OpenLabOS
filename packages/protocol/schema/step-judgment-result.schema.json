{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StepJudgmentResult",
  "description": "Closed-world clip-level step judgment used by training, inference, and eval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_id", "objects_seen", "step_complete", "confidence", "reason"],
  "properties": {
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "judgment_schema_version": {
      "type": "string",
      "enum": ["1"]
    },
    "objects_seen": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mug", "kettle", "tea_bag", "spoon", "tray"]
      }
    },
    "action_detected": {
      "type": ["string", "null"],
      "enum": ["place", "pour", "add", "stir", null]
    },
    "step_complete": {
      "type": "boolean"
    },
    "possible_issue": {
      "type": ["string", "null"],
      "enum": [
        "missing_object",
        "wrong_object",
        "wrong_surface",
        "spill",
        "sequence_error",
        "other",
        null
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
