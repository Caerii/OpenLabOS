{
  "name": "@openlabos/sdk-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenLabOS TypeScript client. Hand-rolled facade today; OpenAPI-generated under _generated/ once services/api publishes its document.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openlabos/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
