OPENLABOS_API_HOST=0.0.0.0
OPENLABOS_API_PORT=3847
CLOUD_MODE=true
CORS_ORIGIN=http://localhost:5174

# Optional reasoning gateway. Start services/inference separately when enabled.
OPENLABOS_INFERENCE_URL=http://localhost:8001

# Safe local default. Set to "sidecar" with LABOS_SEGMENTATION_SIDECAR_URL
# when services/perception is running.
LABOS_ENTITY_SEGMENTATION_MODE=mock

# Operator is the default public-facing experience. Engineering surfaces remain
# available by explicit opt-in.
LABOS_EXPERIENCE_PROFILE=operator
