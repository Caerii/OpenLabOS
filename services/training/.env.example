# Training / data loop helpers
#
# These are optional convenience vars for local scripts. You can also pass flags.

# Where imported LabOS dashboard data lives (contains kitchen/run_events.jsonl and kitchen/frames/)
LABOS_DASHBOARD_DATA=F:/Github/OpenLabOS/data/raw/labos-dashboard

# Dashboard server (teacher) URL for labeling
LABOS_TEACHER_URL=http://localhost:3847

# Local LM Studio OpenAI-compatible server base URL (student fallback)
# Note: OpenAI-compat endpoints are under `/v1` (even if the server itself is at :1234)
# LMSTUDIO_BASE_URL=http://192.168.50.2:1234/v1

# Remote OpenAI-compatible inference endpoint (RunPod / vLLM / SGLang)
REMOTE_OPENAI_BASE_URL=https://<runpod-host>/v1
REMOTE_OPENAI_MODEL_ID=Qwen/Qwen3.5-9B

# Exact model id as reported by LM Studio at GET /v1/models
LMSTUDIO_MODEL_ID=qwen3.5-9b-vlm

# Hugging Face (optional) — for cloud GPU training via Hugging Face Jobs
#
# Docs:
# - Jobs: https://huggingface.co/docs/hub/jobs
# - Jobs pricing: https://huggingface.co/docs/hub/jobs-pricing
#
# Do NOT put secrets in this file. Use a local gitignored `services/training/.env`,
# `hf auth login`, or CI secrets instead.
#
# Example (bash):
#   export HF_JOB_FLAVOR=l4x1
#   export HF_JOB_TIMEOUT=4h
#   export HF_JOB_EXTRA_ARGS="--dataset ... --model ... --out ..."
#   bash services/training/scripts/hf-jobs-train-sft.example.sh
HF_JOB_FLAVOR=l4x1
HF_JOB_TIMEOUT=4h
# HF_JOB_EXTRA_ARGS=--dataset /path/to/sft.jsonl --model Qwen/Qwen3.5-9B --out /tmp/labos-sft-out

# Namespace on the Hugging Face Hub where Jobs should be created (org vs personal)
# Defaulting to Halcyox is convenient when you control org permissions; override if needed.
HF_JOB_NAMESPACE=Halcyox

# Optional: bulk video ingest (see `openlabos-ingest-youtube`)
# LABOS_YOUTUBE_SOURCES_CSV=F:/Github/OpenLabOS/data/sources/youtube_ramen_seed.csv
# LABOS_YOUTUBE_OUT_ROOT=F:/Github/OpenLabOS/data/raw/youtube_ingest
